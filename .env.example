# Copie para .env.local e preencha os valores.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Painel /admin (só no servidor). Chave secreta: Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
ADMIN_EMAILS=seu-email@exemplo.com

# PokéAPI (opcional, padrão: https://pokeapi.co/api/v2)
NEXT_PUBLIC_POKEMON_API_URL=https://pokeapi.co/api/v2

# Blizzard API (https://develop.battle.net/access/clients)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Doações
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_PIX_NAME=
NEXT_PUBLIC_PIX_CITY=
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/seu-usuario

# Google AdSense (vazio desativa os anúncios)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Verificação de buscadores (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Usadas fora do app (migrations e login pelo GitHub configurado no Supabase)
# NEXT_DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres
# NEXT_GITHUB_CLIENT_ID=
# NEXT_GITHUB_CLIENT_SECRET=
